+  title?: string;
+  subtitle?: string;
+  discount?: string;
+  backgroundImage?: string | null;
+  onButtonClick?: () => void;
+}
+
+export const HeroBanner: React.FC<HeroBannerProps> = ({ 
+  title = "28일 후", 
+  subtitle = "시작된 혼란, 28년 후 되살아난 공포",
+  discount = "30%",
+  backgroundImage = null,
+  onButtonClick
+}) => {
+  const [isHovered, setIsHovered] = useState(false);
